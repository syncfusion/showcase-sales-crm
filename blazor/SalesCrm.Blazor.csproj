<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj\generated</CompilerGeneratedFilesOutputPath>
    <!-- Tailwind CSS build hook -->
    <TailwindInput>wwwroot/css/input.css</TailwindInput>
    <TailwindOutput>wwwroot/css/tailwind.css</TailwindOutput>
  </PropertyGroup>

  <Target Name="BuildTailwindCss" BeforeTargets="BuildCore;ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run build:css --silent" Condition="!Exists('$(TailwindOutput)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Syncfusion.Blazor.Core" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Buttons" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Calendars" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Cards" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Charts" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Data" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.DropDowns" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Grid" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Inputs" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.InteractiveChat" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Kanban" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Maps" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Navigations" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Notifications" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Popups" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Schedule" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.SplitButtons" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Blazor.WordProcessor" Version="34.1.30" />
    <PackageReference Include="Syncfusion.Licensing" Version="34.1.30" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
  </ItemGroup>

</Project>
